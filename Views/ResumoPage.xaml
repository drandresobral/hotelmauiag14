<?xml version="1.0" encoding="utf-8"?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" x:Class="AppHotelAgenda13.Views.ResumoPage" Title="Resumo" BackgroundColor="#F2F7FA"><ScrollView><VerticalStackLayout Padding="24,32" Spacing="18"><Label Text="Resumo da estadia" FontSize="30" FontAttributes="Bold"/><Label Text="Confira os dados antes de finalizar." TextColor="#526575"/>
<Border BackgroundColor="White" Stroke="#D9E5EB" StrokeShape="RoundRectangle 20" Padding="22"><VerticalStackLayout Spacing="12"><Label Text="Hóspede" FontAttributes="Bold"/><Label Text="{Binding Nome}"/><Label Text="Acomodação" FontAttributes="Bold"/><Label Text="{Binding Quarto}"/><Label Text="Período" FontAttributes="Bold"/><Label Text="{Binding Periodo}"/><Label Text="Hóspedes" FontAttributes="Bold"/><Label Text="{Binding Hospedes}"/><Label Text="Diárias" FontAttributes="Bold"/><Label Text="{Binding Diarias}"/><Label Text="Valor por diária" FontAttributes="Bold"/><Label Text="{Binding ValorDiariaFormatado}"/><BoxView HeightRequest="1" Color="#D9E5EB"/><Label Text="Total estimado" FontAttributes="Bold"/><Label Text="{Binding TotalFormatado}" FontSize="30" FontAttributes="Bold" TextColor="#008F88"/></VerticalStackLayout></Border>
<Button Text="Concluir simulação" Clicked="OnConcluirClicked"/><Button Text="Editar reserva" BackgroundColor="#DCE9EF" TextColor="#102D42" Clicked="OnVoltarClicked"/><Label Text="Demonstração acadêmica: nenhuma reserva real é enviada." FontSize="13" HorizontalTextAlignment="Center"/></VerticalStackLayout></ScrollView></ContentPage>
